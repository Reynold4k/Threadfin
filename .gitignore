__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.coverage

# data and large artifacts (download via manuscript/case_studies/download.sh)
data/
*.h5ad
*.h5mu
*.h5
manuscript.ipynb

# lineage-tree working files: regenerate with manuscript/case_studies/lineage_trees.py + run_gctree.sh
manuscript/case_studies/results/*/lineage/trees/
manuscript/case_studies/results/*/lineage/*.fasta
manuscript/case_studies/results/*/lineage/status.txt
manuscript/case_studies/logs/
manuscript/case_studies/results/*/matplotlib/

# quickstart and tutorial output, written to the folder they are run from (anchored to the
# repository root so that the documentation images in docs/_static/ are not ignored)
/threadfin_summary.txt
/threadfin_overview.png
/threadfin_overview.pdf
/tutorial_overview.png

# end-to-end tutorial notebook: downloaded data and outputs
docs/tutorials/data/
docs/tutorials/threadfin_tutorial_output/

# private material that must never be published: the manuscript text, third-party PDFs,
# planning notes and the local validation workspace
manuscript/preprint_*/
manuscript/**/*.docx
*.full.pdf
promprt/
internal_validation/

# figure working directories (drafts and layout iterations) stay local; the figure code, the
# provenance records and the analyses behind the figures are published
manuscript/figures/reserve/*
!manuscript/figures/reserve/source/
!manuscript/figures/reserve/provenance/
!manuscript/figures/reserve/revision_2026-10-17/
!manuscript/figures/reserve/figure4_rbd_2026-10-19/
# the Threadfin fish of Figure 1, so that figure1_overview.py can rebuild the figure; the other assets are
# third-party images and stay local
!manuscript/figures/reserve/assets/
manuscript/figures/reserve/assets/*
!manuscript/figures/reserve/assets/threadfin_fish_cartoon.png
manuscript/figures/reserve/revision_2026-10-17/logs/
manuscript/figures/reserve/figure4_rbd_2026-10-19/preview.png
manuscript/figures/reserve/provenance/consolidated_manuscript.json
manuscript/figures/reserve/provenance/Figure_4_measured_validation.json
manuscript/figures/FIGURE5_6_ANALYSIS_PLAN_*.md
manuscript/figures/report/
